{"slug":"contact","content_html":"<div id=\"page-header-2142020173\" class=\"page-header-wrapper\">\n  <div class=\"page-title dark featured-title\">\n\n        <div class=\"page-title-bg\">\n      <div class=\"title-bg fill bg-fill\"\n        data-parallax-container=\".page-title\"\n        data-parallax-background\n        data-parallax=\"-\">\n      </div>\n      <div class=\"title-overlay fill\"></div>\n    </div>\n    \n    <div class=\"page-title-inner container align-center flex-row medium-flex-wrap\" >\n              <div class=\"title-wrapper flex-col text-left medium-text-center\">\n          <h1 class=\"entry-title mb-0\">\n            Liên hệ          </h1>\n        </div>\n                    <div class=\"title-content flex-col flex-right text-right medium-text-center\">\n        <div class=\"title-breadcrumbs pb-half pt-half\"><nav class=\"woocommerce-breadcrumb breadcrumbs uppercase\" aria-label=\"Breadcrumb\">Home</nav></div>      </div>\n    </div>\n\n     \n\n  </div>\n    </div>\n  \n\n\t<section class=\"section dark\" id=\"section_1778093114\">\n\t\t<div class=\"section-bg fill\" >\n\t\t\t\t\t\t\t\t\t\n\t\t\t\n\n\t\t</div>\n\n\t\t\n\n\t\t<div class=\"section-content relative\">\n\t\t\t\n<div class=\"row\"  id=\"row-391725629\"></p>\n<p>\n\t<div id=\"col-115048059\" class=\"col medium-3 small-6 large-3\"  >\n\t\t\t\t<div class=\"col-inner text-center\"  >\n\t\t\t\n\t\t\t</p>\n<p>\t<div class=\"img has-hover x md-x lg-x y md-y lg-y\" id=\"image_173694300\">\n\t\t\t\t\t\t\t\t<div class=\"img-inner dark\" >\n\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"646\" height=\"640\" src=\"https://vneconomics.com/wp-content/uploads/2020/12/118547447_3345729608824413_1836745544207601620_n.jpg\" class=\"attachment-original size-original\" alt=\"\" srcset=\"https://vneconomics.com/wp-content/uploads/2020/12/118547447_3345729608824413_1836745544207601620_n.jpg 646w, https://vneconomics.com/wp-content/uploads/2020/12/118547447_3345729608824413_183674554420